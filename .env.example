# ClothesLook - variables de entorno de ejemplo / example environment variables
#
# Django no lee este fichero por si solo: exporta las variables en tu shell
# (bash: export NOMBRE=valor; PowerShell: $env:NOMBRE = "valor").
# Nunca subas a git un .env con valores reales.

# Desarrollo local: con DJANGO_DEBUG=1 se usa una clave de desarrollo si no
# defines DJANGO_SECRET_KEY. Fuera de desarrollo, dejalo a 0.
DJANGO_DEBUG=1

# Obligatoria si DJANGO_DEBUG no es 1. Genera una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# Hosts permitidos (separados por comas). Obligatorio con DJANGO_DEBUG=0.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
